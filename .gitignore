*.log

# Local operator scripts embed credentials; never commit them.
inspect-cipher.mjs
set-secrets.mjs
add-domain.mjs
add-dns.mjs
attach-route.mjs

# Extension signing artefacts are local only; never commit a private key
extension.pem
extension.crx

# Test files are scratch by default so a half-written probe cannot slip in.
# Every suite the repo relies on is listed below and stays versioned.
test-*.mjs
!test-mf-*.mjs
!test-oidc.mjs
!test-r1-r6.mjs
!test-cli.mjs
!test-agents.mjs
!test-ui-item-page.mjs
!test-plugin-endpoints.mjs
!dsh-plugin/test-popup.mjs
!dsh-plugin/test-popup-actions.mjs
!dsh-plugin/test-plugin-guard.mjs
