{
  "name": "secrets-broker-workers",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "vars": {
    "VAULT_EMAIL": "you@example.com",
    "MCP_ALLOW_READ": "1",
    "OIDC_ISSUER": "https://auth.example.com",
    "OIDC_CLIENT_ID": "your-oidc-client-id",
    "OIDC_REDIRECT_URI": "https://your-worker.example/oidc/callback"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BROKER_STATE", "class_name": "BrokerState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BrokerState"] }
  ],
  "services": [
    { "binding": "NODEWARDEN", "service": "nodewarden" }
  ],
  "d1_databases": [
    {
      "binding": "NODEWARDEN_DB",
      "database_name": "nodewarden-db",
      "database_id": "REPLACE_WITH_NODEWARDEN_D1_ID"
    }
  ]
}
